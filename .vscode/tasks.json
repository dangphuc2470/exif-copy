{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run App & Stream Live Logs (Like 'flutter run')",
            "type": "shell",
            "command": "powershell -ExecutionPolicy Bypass -File .\\run.ps1",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build Debug APK Only",
            "type": "shell",
            "command": ".\\gradlew.bat assembleDebug",
            "group": "build",
            "problemMatcher": []
        }
    ]
}
